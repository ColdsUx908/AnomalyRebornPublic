StarfallKnockerHoldout.DisplayName: 叩星
StarfallKnockerBurst.DisplayName: 叩星星爆

StarfallKnocker: {
	DisplayName: 叩星
	Tooltip:
		'''
		按住左键蓄力4.5秒，松开将叩星砸向前方
		提前松开会取消攻击；蓄力期间可以自由移动
		锤头到位时引发星爆，直接命中的敌人额外承受一次等额伤害
		'''
}

