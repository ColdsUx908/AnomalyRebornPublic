			复现传说之夜所必需的材料
			它曾经历无数次的坠落
			'''
	}

	MemoryofAstraeus: {
		DisplayName: 星星之神的记忆
		Tooltip: 放置在祭坛上即可复现传说之夜
	}

	CoinBag: {
		DisplayName: 钱币袋
