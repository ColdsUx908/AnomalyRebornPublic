StarfallKnockerHoldout.DisplayName: Starfall Knocker
StarfallKnockerBurst.DisplayName: Starfall Knocker Starburst

StarfallKnocker: {
	DisplayName: Starfall Knocker
	Tooltip:
		'''
		Hold left click for 4.5 seconds, then release to slam the hammer forward
		Releasing early cancels the attack; you can move freely while charging
		The impact always creates a starburst; enemies struck by the hammer take an additional hit of equal base damage
		'''
}

