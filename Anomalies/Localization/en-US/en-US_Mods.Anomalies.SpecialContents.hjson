Developer: {
	AscendantWings: {
		DisplayName: Ascendant Wings
		Tooltip:
			'''
			Legendary wings that soar through the sky
			Created from the feathers of a golden eagle struck by lightning on a stormy night
			They can carry you to any height with a single flap
			'''
	}

	ColdheartIcicle: {
		DisplayName: Coldheart Icicle
		Tooltip: ""
	}

	ColdheartIcicleDream.DisplayName: Coldheart Icicle Dream
	ColdheartIcicleIceRain.DisplayName: Coldheart Icicle Ice Rain
	ColdheartIcicleProj.DisplayName: Coldheart Icicle
	ColdheartIcicleSnowflake.DisplayName: Coldheart Icicle Snowflake

	TestItem: {
		DisplayName: Test Item
		Tooltip: Only for testing purposes
	}

	EventideReunion: {
		DisplayName: Eventide Reunion
		Tooltip:
			'''
			The sun burns all to ash, samsara weaves cause and effect; life blossoms anew, death reaps the end; sacred light judges sin, stars collapse into cores
			Six aspects turn, the final sun rises
			'''
		EventideReunionSelection.DisplayName: Eventide Reunion Selection
		EventideReunionSunExplosion.DisplayName: Coronal Flare
		EventideReunionDeathWave.DisplayName: Extinction Scythe Wave
		EventideReunionDeathSoul.DisplayName: Reaped Soul
		EventideReunionSacrednessSkill.DisplayName: Sacred Judgment
		EventideReunionSamsaraEcho.DisplayName: Karmic Echo
		EventideReunionLifeFruit.DisplayName: Fruit of Renewal

		EventideReunionLifeBlessing: {
			DisplayName: Sacred Renewal
			Description: Each Fruit of Renewal collected increases maximum life by 10%, up to 30% total, and refreshes the 15-second duration
		}

		EventideReunionResonance: {
			DisplayName: Samsara Resonance
			Description: Each stack multiplies melee damage by 1.08 and reduces skill cooldowns by 5%; a new aspect refreshes the 30-second duration, while a repeated aspect removes itself and one random remaining mark and increases that cast's cooldown by 20%
		}
	}
}

Contributor: {
	MeguminStaff: {
		DisplayName: Megumin's Staff
		Tooltip:
			'''
			Chant in the name of the Crimson Demons, and let crimson-gold light pierce heaven and earth
			Hold to cast Explosion; move the mouse to guide the beam and layered magic circles
			My name is Megumin! Explosion!
			'''
		MeguminChant.DisplayName: Explosion Chant
		MeguminBeam.DisplayName: Explosion

		MeguminExhaustion: {
			DisplayName: Mana Exhaustion
			Description: Explosion has drained your strength; you cannot cast the magic again yet
		}
	}

	ImmaculateWhite: {
		DisplayName: Immaculate White
		Tooltip: Shoot immaculate light that rapidly tracks enemies
		Tooltip1: Immaculate light will split into more immaculate light
		Tooltip2: Press <right> to shoot piercing immaculate light
		ImmaculateBolt.DisplayName: Immaculate Bolt
	}

	VacuousBlack: {
		DisplayName: Vacuous Black
		Tooltip: Summon vacuous darkness to devour everything
		VacuousBlackBuff.Description: It desires to devour everything, maybe even you.
	}
}

