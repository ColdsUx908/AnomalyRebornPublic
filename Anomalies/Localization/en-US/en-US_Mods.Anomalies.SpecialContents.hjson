			The Lord of a frozen world vs. one cute bunny. Who would win?
			'''
		MarchHare.DisplayName: March Hare
		CarrotBlast.DisplayName: Carrot Missile Explosion
		CarrotMissile.DisplayName: Carrot Missile
	}
